                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/{{user_id}}/reset-password",
              "host": ["{{base_url}}"],
              "path": ["user", "{{user_id}}", "reset-password"]
            }
          }
        }
      ]
    },
