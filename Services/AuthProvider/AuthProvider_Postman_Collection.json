              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lockoutMinutes\": 60,\n  \"reason\": \"Security violation\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/{{user_id}}/lock",
              "host": ["{{base_url}}"],
              "path": ["user", "{{user_id}}", "lock"]
            }
          }
        },
        {
          "name": "Unlock User Account",
          "request": {
            "method": "POST",
            "header": [],
