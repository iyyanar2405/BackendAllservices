              "raw": "{\n  \"userName\": \"testuser@example.com\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123!\",\n  \"phoneNumber\": \"+1234567890\",\n  \"emailConfirmed\": true,\n  \"lockoutEnabled\": true,\n  \"twoFactorEnabled\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"updated.user@example.com\",\n  \"email\": \"updated.user@example.com\",\n  \"phoneNumber\": \"+1234567891\",\n  \"emailConfirmed\": true,\n  \"lockoutEnabled\": false,\n  \"twoFactorEnabled\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["user", "{{user_id}}"]
