{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Environment_Name": "Dev", //must match file after appsettings. Dev, Prod or Test
  "EmailServiceUrl": "https://localhost/",
  "ChorusAppApi": "http://localhost:38734/V2",

  "IdentityServer": {
    "Key": { //This is only used as a initial template so that the real cert can be loaded from the database
      "Type": "Store",
      "StoreName": "My",
      "StoreLocation": "LocalMachine",
      "Name": "CN=localhost"
    },
    "Clients": {
      "createIdentityTables": {
        "Profile": "IdentityServerSPA"
      }
    }
  },
  "Allow_Emails": false,
  "Allow_Swagger": true,
  "WhiteList": "*",
  "IsDbMigration": false,
  "AllowedHosts": "*",
  "RefreshTokenExpireTime": 60,
  "TfaTokenExpireTime": 10,
  "JwtExpireTime": 20,
  "SessionExpireTime": 0, //0 means let the Refresh Token handle it.. otherwise limit to users last touch must be less then refreshToken Time.
  "MaxFailedAccessAttempts": 5,
  "ConnectionStrings": {
    "AuthProviderConn": "Server=.;Database=AuthProvider;Trusted_Connection=True;TrustServerCertificate=True",
    "CustomerPortalConn": "Server=.;Database=Customer_PortalI;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "ClientAppSettings": {
    "Url": "https://localhost/AuthProvider",
    "EmailConfirmationPath": "/VerifyEmail",
    "ResetPasswordPath": "/Auth/ChangePassword",
    "RestTokenExpireTime": 20
  }

}